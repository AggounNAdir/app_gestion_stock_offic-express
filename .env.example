# Serveur HTTP
PORT=3000
NODE_ENV=development

# Sécurité / JWT (API Portail Client & Tournée)
API_ENV=development
API_SECRET_KEY=dev_secret_key_change_me_min_32_characters_long
API_TOKEN_EXPIRE_MINUTES=60
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_TRUSTED_PROXIES=

# Tarification & contrôle des marges
PRIX_MARGE_MIN_PCT=0
PRIX_CONTROLE_COMMANDES=enforce

# PostgreSQL local / serveur
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=votre_mot_de_passe
PGDATABASE=gestion_stock
